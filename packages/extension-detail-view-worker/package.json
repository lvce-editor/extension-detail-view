{
  "name": "@lvce-editor/extension-detail-view",
  "version": "0.0.0-dev",
  "description": "Extension Detail View Worker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvce-editor/extension-detail-view.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/extensionDetailViewWorkerMain.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build:watch": "cd ../../ && npm run build:watch",
    "dev": "cd ../../ && npm run dev",
    "format": "prettier --write .",
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 98,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@lvce-editor/assert": "^1.9.0",
    "@lvce-editor/constants": "^5.30.0",
    "@lvce-editor/i18n": "^2.10.0",
    "@lvce-editor/rpc": "^6.21.1",
    "@lvce-editor/rpc-registry": "^9.66.0",
    "@lvce-editor/verror": "^1.7.0",
    "@lvce-editor/viewlet-registry": "^5.12.0",
    "@lvce-editor/virtual-dom-worker": "^11.22.0",
    "@types/node": "^22.14.0",
    "jest": "^30.5.2",
    "pretty-bytes": "^7.2.0",
    "ts-jest": "^29.4.14"
  }
}
