{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["esbuild", "playwright"]
    },
    "packages/e2e": {
      "entry": ["e2e.config.js", "src/**/*.ts", "scripts/*.js", "fixtures/**/main.js", "fixtures/**/index.js"],
      "project": ["src/**/*.ts", "scripts/*.js", "fixtures/**/*.js", "e2e.config.js"]
    },
    "packages/extension-detail-view-worker": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.js"]
    }
  }
}
